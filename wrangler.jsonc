{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyloka-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "keyloka-web"
    }
  ],
  "env": {
    "dev": {
      "name": "keyloka-web-dev",
      "routes": [{ "pattern": "dev.keyloka.com", "custom_domain": true }],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "keyloka-web-dev" }
      ],
      "vars": { "API_BASE_URL": "https://api-dev.keyloka.com/api" }
    }
  }
}
